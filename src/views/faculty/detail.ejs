<%- include('../partials/header') %>

<main>
    <h1><%= faculty.name %></h1>

    <div class="faculty-detail">
        <img
            src="/images/faculty/<%= faculty.slug %>.jpg"
            alt="Photo of <%= faculty.name %>"
            class="faculty-image"
        >

        <p><strong>Title:</strong> <%= faculty.title %></p>
        <p><strong>Department:</strong> <%= faculty.department %></p>
        <p><strong>Office:</strong> <%= faculty.office %></p>
        <p><strong>Phone:</strong> <%= faculty.phone %></p>
        <p>
            <strong>Email:</strong>
            <a href="mailto:<%= faculty.email %>"><%= faculty.email %></a>
        </p>
    </div>

    <p>
        <a href="/faculty">← Back to Faculty Directory</a>
    </p>
</main>

<%- include('../partials/footer') %>
