<%- include('partials/header') %>

<main>
    <h1><%= course.id %> - <%= course.title %></h1>

    <p><strong>Department:</strong> <%= course.department %></p>
    <p><strong>Credits:</strong> <%= course.credits %></p>
    <p><%= course.description %></p>

    <h2>Sections</h2>

    <p>
        Sort by:
        <a href="/catalog/<%= course.id %>?sort=time">Time</a>
        <a href="/catalog/<%= course.id %>?sort=professor">Professor</a>
        <a href="/catalog/<%= course.id %>?sort=room">Room</a>
    </p>

    <% course.sections.forEach(section => { %>
        <div>
            <p><strong>Time:</strong> <%= section.time %></p>
            <p><strong>Professor:</strong> <%= section.professor %></p>
            <p><strong>Room:</strong> <%= section.room %></p>
        </div>
    <% }); %>

    <p><a href="/catalog">← Back to Course Catalog</a></p>
</main>

<%- include('partials/footer') %>